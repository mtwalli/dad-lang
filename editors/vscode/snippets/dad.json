{
  "Function (دالة)": {
    "prefix": [
      "دالة",
      "func"
    ],
    "body": [
      "دالة ${1:اسم}(${2:معامل}: ${3:نص}): ${4:نص} {",
      "\t$0",
      "}"
    ],
    "description": "دالة بجسم كامل — a function with a block body"
  },
  "Short function (دالة =)": {
    "prefix": [
      "دالة=",
      "fun"
    ],
    "body": [
      "دالة ${1:اسم}(${2:س}: ${3:صحيح}) = ${0:س}"
    ],
    "description": "دالة مختصرة — a one-expression function"
  },
  "Value type (نوع)": {
    "prefix": [
      "نوع",
      "type"
    ],
    "body": [
      "نوع ${1:اسم}(${2:حقل}: ${3:نص}) {",
      "\t$0",
      "}"
    ],
    "description": "نوع قيمة بحقول — a value type"
  },
  "Enum (تعداد)": {
    "prefix": [
      "تعداد",
      "enum"
    ],
    "body": [
      "تعداد ${1:اسم} {",
      "\t${2:حالة_أولى}",
      "\t${3:حالة_ثانية}(${4:قيمة}: ${5:صحيح})",
      "}"
    ],
    "description": "تعداد بحالات — an enum"
  },
  "Match (طابق)": {
    "prefix": [
      "طابق",
      "match"
    ],
    "body": [
      "طابق ${1:قيمة} {",
      "\t${2:نمط} => ${3:ناتج}",
      "\t_ => ${0:افتراضي}",
      "}"
    ],
    "description": "مطابقة شاملة — exhaustive match"
  },
  "If (إذا)": {
    "prefix": [
      "إذا",
      "if"
    ],
    "body": [
      "إذا ${1:شرط} {",
      "\t$0",
      "}"
    ],
    "description": "شرط — if"
  },
  "If-else (إذا وإلا)": {
    "prefix": [
      "إذا وإلا",
      "ifelse"
    ],
    "body": [
      "إذا ${1:شرط} {",
      "\t$2",
      "} وإلا {",
      "\t$0",
      "}"
    ],
    "description": "شرط مع بديل — if/else"
  },
  "For in (لكل في)": {
    "prefix": [
      "لكل",
      "for"
    ],
    "body": [
      "لكل ${1:عنصر} في ${2:قائمة} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة على عناصر — for each"
  },
  "For range (لكل من إلى)": {
    "prefix": [
      "لكل من",
      "forr"
    ],
    "body": [
      "لكل ${1:ع} من ${2:1} إلى ${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة على مدى — for over a range"
  },
  "While (طالما)": {
    "prefix": [
      "طالما",
      "while"
    ],
    "body": [
      "طالما ${1:شرط} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة شرطية — while"
  },
  "Try (حاول التقط)": {
    "prefix": [
      "حاول",
      "try"
    ],
    "body": [
      "حاول {",
      "\t$1",
      "} التقط ${2:خ} {",
      "\t${0:اطبع($2.رسالة)}",
      "}"
    ],
    "description": "معالجة الأخطاء — try/catch"
  },
  "Print (اطبع)": {
    "prefix": [
      "اطبع",
      "print"
    ],
    "body": [
      "اطبع(\"$1\")$0"
    ],
    "description": "اطبع نصاً — print"
  },
  "Constant (ثابت)": {
    "prefix": [
      "ثابت",
      "let"
    ],
    "body": [
      "ثابت ${1:اسم} = $0"
    ],
    "description": "قيمة ثابتة — constant"
  },
  "Variable (متغير)": {
    "prefix": [
      "متغير",
      "var"
    ],
    "body": [
      "متغير ${1:اسم} = $0"
    ],
    "description": "قيمة متغيرة — variable"
  }
}