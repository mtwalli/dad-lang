{
  "name": "dad-lang",
  "displayName": "Ḍād (ضاد)",
  "description": "Support for the Ḍād Arabic programming language: highlighting, errors as you type, run button, snippets and keyword help.",
  "version": "0.2.0",
  "publisher": "mtwalli",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtwalli/dad-lang"
  },
  "homepage": "https://mtwalli.github.io/dad-lang/editor/",
  "bugs": {
    "url": "https://github.com/mtwalli/dad-lang/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "arabic",
    "dad",
    "ضاد",
    "عربي",
    "rtl"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "dad",
        "aliases": [
          "Ḍād",
          "ضاد",
          "dad"
        ],
        "extensions": [
          ".dad"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file.svg",
          "dark": "./images/file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dad",
        "scopeName": "source.dad",
        "path": "./syntaxes/dad.tmLanguage.json"
      },
      {
        "scopeName": "markdown.dad.codeblock",
        "path": "./syntaxes/markdown-dad.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.dad": "dad"
        }
      }
    ],
    "snippets": [
      {
        "language": "dad",
        "path": "./snippets/dad.json"
      }
    ],
    "commands": [
      {
        "command": "dad.run",
        "title": "Run Ḍād File (شغّل)",
        "category": "Ḍād",
        "icon": "$(play)"
      },
      {
        "command": "dad.check",
        "title": "Check Ḍād File (افحص)",
        "category": "Ḍād"
      },
      {
        "command": "dad.showVersion",
        "title": "Show Installed Version",
        "category": "Ḍād"
      },
      {
        "command": "dad.installFont",
        "title": "Install the Ḍād Mono Font",
        "category": "Ḍād"
      },
      {
        "command": "dad.openRightToLeft",
        "title": "Reopen Right to Left",
        "category": "Ḍād",
        "icon": "$(arrow-left)"
      },
      {
        "command": "dad.openAsText",
        "title": "Reopen as Text (Left to Right)",
        "category": "Ḍād",
        "icon": "$(file-code)"
      },
      {
        "command": "dad.format",
        "title": "Format Document",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.definition",
        "title": "Go to Definition",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.references",
        "title": "Find All References",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.symbol",
        "title": "Go to Symbol in File…",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.workspaceSymbol",
        "title": "Go to Symbol in Workspace…",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.rename",
        "title": "Rename Symbol",
        "category": "Ḍād"
      },
      {
        "command": "dad.rtl.back",
        "title": "Go Back",
        "category": "Ḍād"
      },
      {
        "command": "dad.preview",
        "title": "Preview Interface (معاينة)",
        "category": "Ḍād",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "dad.run",
          "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dad.run",
          "when": "editorLangId == dad",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "dad.run",
          "when": "resourceExtname == .dad",
          "group": "navigation"
        },
        {
          "command": "dad.preview",
          "when": "resourceExtname == .dad",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dad.check",
          "when": "editorLangId == dad"
        },
        {
          "command": "dad.run",
          "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.openRightToLeft",
          "when": "editorLangId == dad"
        },
        {
          "command": "dad.openAsText",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.format",
          "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.definition",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.references",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.symbol",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.workspaceSymbol",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.rename",
          "when": "activeCustomEditorId == dad.rtlEditor"
        },
        {
          "command": "dad.rtl.back",
          "when": "activeCustomEditorId == dad.rtlEditor && dad.rtlCanGoBack"
        },
        {
          "command": "dad.preview",
          "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor"
        }
      ],
      "editor/title": [
        {
          "command": "dad.preview",
          "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor",
          "group": "navigation@1"
        },
        {
          "command": "dad.openRightToLeft",
          "when": "editorLangId == dad && activeCustomEditorId != dad.rtlEditor",
          "group": "navigation"
        },
        {
          "command": "dad.openAsText",
          "when": "activeCustomEditorId == dad.rtlEditor",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "dad.preview",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "z_commands@0"
        },
        {
          "command": "dad.rtl.definition",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "navigation@1"
        },
        {
          "command": "dad.rtl.references",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "navigation@2"
        },
        {
          "command": "dad.rtl.symbol",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "navigation@3"
        },
        {
          "command": "dad.rtl.workspaceSymbol",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "navigation@4"
        },
        {
          "command": "dad.rtl.back",
          "when": "webviewId == 'dad.rtlEditor' && dad.rtlCanGoBack",
          "group": "navigation@5"
        },
        {
          "command": "dad.rtl.rename",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "1_modification@1"
        },
        {
          "command": "dad.format",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "1_modification@2"
        },
        {
          "command": "dad.run",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "z_commands@1"
        },
        {
          "command": "dad.openAsText",
          "when": "webviewId == 'dad.rtlEditor'",
          "group": "z_commands@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dad.run",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "(editorTextFocus && editorLangId == dad) || activeCustomEditorId == dad.rtlEditor"
      },
      {
        "command": "dad.format",
        "key": "shift+alt+f",
        "linux": "ctrl+shift+i",
        "when": "activeCustomEditorId == dad.rtlEditor && !editorTextFocus"
      },
      {
        "command": "dad.rtl.symbol",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == dad.rtlEditor && !editorTextFocus && !inQuickOpen"
      },
      {
        "command": "dad.rtl.workspaceSymbol",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == dad.rtlEditor && !editorTextFocus && !inQuickOpen"
      },
      {
        "command": "dad.rtl.back",
        "key": "alt+left",
        "mac": "ctrl+-",
        "linux": "ctrl+alt+-",
        "when": "activeCustomEditorId == dad.rtlEditor && !editorTextFocus && !inQuickOpen && dad.rtlCanGoBack"
      },
      {
        "command": "dad.preview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == dad || activeCustomEditorId == dad.rtlEditor"
      }
    ],
    "configuration": {
      "title": "Ḍād",
      "properties": {
        "dad.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `dad` program. Leave empty to find it on your `PATH` or in the default install folder (`~/.dad/bin`)."
        },
        "dad.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check the file for errors as you type. When off, files are checked when opened and saved."
        },
        "dad.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file before running it."
        },
        "dad.formatOnSave": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Format `.dad` files with `dad fmt` when you save them, in both the right-to-left editor and the text editor. Files with errors are saved as they are."
        }
      }
    },
    "configurationDefaults": {
      "[dad]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?،؛؟«»",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.encoding": "utf8",
        "editor.fontFamily": "'Dad Mono', Menlo, Monaco, Consolas, 'DejaVu Sans Mono', 'Courier New', monospace"
      }
    },
    "customEditors": [
      {
        "viewType": "dad.rtlEditor",
        "displayName": "Ḍād (right to left)",
        "selector": [
          {
            "filenamePattern": "*.dad"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "dad-panel",
          "title": "Ḍād",
          "icon": "images/file.svg"
        }
      ]
    },
    "views": {
      "dad-panel": [
        {
          "type": "webview",
          "id": "dad.output",
          "name": "Output · المخرجات"
        }
      ]
    }
  }
}
