{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ḍād",
  "scopeName": "source.dad",
  "fileTypes": [
    "dad"
  ],
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#braces"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.dad",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.dad"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.dad"
            }
          }
        },
        {
          "name": "comment.line.double-slash.dad",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.dad"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.dad",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dad"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dad"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.double.dad",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dad"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dad"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.guillemet.dad",
          "begin": "«",
          "end": "»|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.dad"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.dad"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.dad",
          "match": "\\\\[nrt0\\\\\"{}«»]"
        },
        {
          "name": "invalid.illegal.escape.dad",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.dad",
          "contentName": "source.dad",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.dad"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.dad"
            }
          },
          "patterns": [
            {
              "include": "#statements"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(دالة)\\s+([\\p{L}\\p{Mn}_][\\p{L}\\p{Mn}0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.dad"
            },
            "2": {
              "name": "entity.name.function.dad"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(نوع|تعداد|عقد|امتداد|مكون|جدول)\\s+([\\p{L}\\p{Mn}_][\\p{L}\\p{Mn}0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.dad"
            },
            "2": {
              "name": "entity.name.type.dad"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(ثابت|متغير)\\s+([\\p{L}\\p{Mn}_][\\p{L}\\p{Mn}0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.dad"
            },
            "2": {
              "name": "variable.other.declaration.dad"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:بخطوة|طالما|التقط|وإلا|طابق|أرجع|توقف|تابع|حاول|ارفع|إذا|لكل|إلى|حتى|في|من)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "storage.type.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:امتداد|تعداد|دالة|مكون|جدول|مسار|خادم|حالة|نوع|عقد)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "storage.modifier.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:استورد|متغير|ثابت|خاص)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "constant.language.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:خطأ|عدم|صح)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "keyword.operator.word.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:ليس|أو|هو|و|ك)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "variable.language.this.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:هذا)(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "support.type.builtin.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(?:منطقي|قائمة|قاموس|صحيح|عشري|نص)(?![\\p{L}\\p{Mn}0-9_])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.dad",
          "match": "(?<![\\p{L}\\p{Mn}0-9_])[0-9](?:[0-9_]*[0-9])?(?:\\.[0-9](?:[0-9_]*[0-9])?)?(?![\\p{L}\\p{Mn}0-9_])"
        },
        {
          "name": "invalid.illegal.digits.dad",
          "match": "[٠-٩۰-۹٫٬]+"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{Mn}0-9_])(اطبع|مشكلة|جذر|مطلق|أدنى|أقصى)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "support.function.builtin.dad"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{Mn}0-9_])([\\p{L}\\p{Mn}_][\\p{L}\\p{Mn}0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.dad"
            }
          }
        },
        {
          "match": "(?<=\\.)([\\p{L}\\p{Mn}_][\\p{L}\\p{Mn}0-9_]*)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.call.dad"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.dad",
          "match": "=>"
        },
        {
          "name": "keyword.operator.optional.dad",
          "match": "[?؟](?:\\.|[?؟])"
        },
        {
          "name": "keyword.operator.range.dad",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.dad",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.compound.dad",
          "match": "[-+*/]="
        },
        {
          "name": "keyword.operator.logical.dad",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.dad",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.dad",
          "match": "[-+*/%]"
        },
        {
          "name": "keyword.operator.optional.dad",
          "match": "[?؟]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.dad",
          "match": "[,،]"
        },
        {
          "name": "punctuation.terminator.statement.dad",
          "match": "[;؛]"
        },
        {
          "name": "punctuation.accessor.dad",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.dad",
          "match": ":"
        },
        {
          "name": "invalid.illegal.bidi.dad",
          "match": "[‪-‮⁦-⁩‎‏؜]"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.dad"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.dad"
        }
      },
      "patterns": [
        {
          "include": "#statements"
        }
      ]
    }
  }
}