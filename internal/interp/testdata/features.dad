// عوامل، استدعاء ذاتي، إغلاقات، حلقات
دالة مضروب(ن: صحيح): صحيح = إذا ن <= ١ { ١ } وإلا { ن * مضروب(ن - ١) }
اطبع("مضروب ١٠ =", مضروب(١٠))

دالة عداد_جديد() {
  متغير ع = ٠
  أرجع { ع += ١؛ ع }
}
ثابت عد = عداد_جديد()
عد()؛ عد()
اطبع("العداد:", عد())

متغير س = ٠
طالما صح {
  س += ١
  إذا س % ٢ == ٠ { تابع }
  إذا س > ٧ { توقف }
  اطبع("فردي", س)
}

ثابت أعمار = ["سارة": ٣٠، "علي": ٢٥]
لكل اسم في أعمار { اطبع(اسم, أعمار[اسم]) }
ثابت أرقام = [٥، ٣، ٨، ١]
اطبع(أرقام.رتب(), أرقام.مجموع(), أرقام.عدد { هو > ٢ }, أقصى(أرقام))
اطبع("  مرحبا  ".قص().طول, "أ-ب-ج".قسم("-"), "ضاد".أحرف().عكس().ضم(""))
اطبع(١٠ / ٣, ١٠ % ٣, ١٠ ك عشري / ٤, ٢٫٥ ك صحيح, "٤٢" ك صحيح + ١)
اطبع(صح و ليس خطأ, عدم ؟؟ "افتراضي", [١، ٢] == [١، ٢])
اطبع(من ١ إلى ٥, (من ١٠ إلى ١ بخطوة -٣).ضم("، "))
تعداد اتجاه { شمال، جنوب }
ثابت ج = شمال
اطبع(طابق ج { شمال => "↑" ; جنوب => "↓" })
نوع شخص(اسم: نص، عمر: صحيح = ٠) {
  دالة تحية() = "أنا {اسم} وعمري {عمر}"
  دالة أكبر(سنوات: صحيح) = نسخة(عمر: عمر + سنوات)
}
ثابت ه = شخص("هدى")
اطبع(ه.تحية(), ه.أكبر(٥).تحية(), ه)
