// عوامل، استدعاء ذاتي، إغلاقات، حلقات
دالة مضروب(ن: صحيح): صحيح = إذا ن <= 1 { 1 } وإلا { ن * مضروب(ن - 1) }
اطبع("مضروب 10 =", مضروب(10))

دالة عداد_جديد() {
    متغير ع = 0
    أرجع {
        ع += 1
        ع
    }
}

ثابت عد = عداد_جديد()
عد()
عد()
اطبع("العداد:", عد())

متغير س = 0
طالما صح {
    س += 1
    إذا س % 2 == 0 { تابع }
    إذا س > 7 { توقف }
    اطبع("فردي", س)
}

ثابت أعمار = ["سارة": 30، "علي": 25]
لكل اسم في أعمار { اطبع(اسم, أعمار[اسم]) }
ثابت أرقام = [5، 3، 8، 1]
اطبع(أرقام.رتب(), أرقام.مجموع(), أرقام.عدد { هو > 2 }, أقصى(أرقام))
اطبع("  مرحبا  ".قص().طول, "أ-ب-ج".قسم("-"), "ضاد".أحرف().عكس().ضم(""))
اطبع((10 / 3) ك صحيح, 10 % 3, 10 ك عشري / 4, 2.5 ك صحيح, "42" ك صحيح + 1)
اطبع(صح و ليس خطأ, عدم ؟؟ "افتراضي", [1، 2] == [1، 2])
اطبع(من 1 إلى 5, (من 10 إلى 1 بخطوة -3).ضم("، "))
تعداد اتجاه { شمال، جنوب }
ثابت ج = شمال
اطبع(طابق ج {
    شمال => "↑"
    جنوب => "↓"
})

نوع شخص(اسم: نص، عمر: صحيح = 0) {
    دالة تحية() = "أنا {اسم} وعمري {عمر}"
    دالة أكبر(سنوات: صحيح) = نسخة(عمر: عمر + سنوات)
}

ثابت ه = شخص("هدى")
اطبع(ه.تحية(), ه.أكبر(5).تحية(), ه)
اطبع(7 / 2، 6 / 2، (7 / 2) ك صحيح)
إذا 2.5 من نوع عشري و ليس ("ن" من نوع صحيح) { اطبع("أنواع") }
