// تطبيق مهام كامل: بيانات + خادم + واجهة في ملف واحد

جدول مهام {
    عنوان: نص
    منجزة = خطأ
}

خادم دالة المهام() = مهام.الكل()
خادم دالة أضف(عنوان: نص) = مهام.أنشئ(عنوان: عنوان)
خادم دالة بدل(م: مهام) = م.نسخة(منجزة: ليس م.منجزة).احفظ()

// واجهة برمجية عامة للبرامج الأخرى
مسار جلب "/api/مهام" = مهام.الكل()

مكون قائمة_المهام() {
    حالة مهام = المهام()
    حالة جديدة = ""

    عمود {
        عنوان("مهامي ({مهام.رشح { ليس هو.منجزة }.عدد} متبقية)")
        صف {
            حقل(جديدة، تلميح: "مهمة جديدة…")
            زر("أضف") {
                أضف(جديدة)
                مهام = المهام()
                جديدة = ""
            }
        }
        لكل م في مهام {
            صف {
                مربع_اختيار(م.منجزة) {
                    بدل(م)
                    مهام = المهام()
                }
                فقرة(م.عنوان)
            }
        }
    }
}
