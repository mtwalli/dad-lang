// تطبيق مهام كامل: بيانات + خادم + واجهة في ملف واحد

جدول مهمة {
  عنوان: نص
  منجزة = خطأ
}

خادم دالة المهام() = مهمة.الكل()
خادم دالة أضف(عنوان: نص) = مهمة.أنشئ(عنوان: عنوان)
خادم دالة بدل(م: مهمة) = م.نسخة(منجزة: ليس م.منجزة).احفظ()

// واجهة برمجية عامة للبرامج الأخرى
مسار جلب "/api/مهام" = مهمة.الكل()

مكون قائمة_المهام() {
  حالة مهام = المهام()
  حالة جديدة = ""

  عمود {
    عنوان("مهامي ({مهام.رشح { ليس هو.منجزة }.عدد} متبقية)")
    صف {
      حقل(جديدة، تلميح: "مهمة جديدة…")
      زر("أضف") {
        أضف(جديدة)
        مهام = المهام()
        جديدة = ""
      }
    }
    لكل م في مهام {
      صف {
        مربع_اختيار(م.منجزة) { بدل(م)؛ مهام = المهام() }
        فقرة(م.عنوان)
      }
    }
  }
}
