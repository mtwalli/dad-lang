// أنواع القيم، التعدادات، والمطابقة الشاملة
نوع نقطة(س: عشري، ص: عشري) {
  دالة بعد() = جذر(س * س + ص * ص)
}

تعداد شكل {
  دائرة(قطر: عشري)
  مستطيل(عرض: عشري، طول: عشري)
  مثلث(قاعدة: عشري، ارتفاع: عشري)
}

دالة مساحة(ش: شكل): عشري = طابق ش {
  دائرة(ق) => ٣٫١٤١٦ * ق * ق / ٤
  مستطيل(ع، ط) => ع * ط
  مثلث(ق، ر) => ق * ر / ٢
}

ثابت أشكال = [دائرة(٢)، مستطيل(٣، ٤)، مثلث(قاعدة: ٦، ارتفاع: ٢)]
لكل ش في أشكال {
  اطبع("المساحة = {مساحة(ش)}")
  إذا ش هو دائرة { اطبع("قطرها {ش.قطر}") }
}

ثابت ن = نقطة(س: ٣، ص: ٤)
اطبع(ن.بعد())              // ٥
اطبع(ن == نقطة(٣، ٤))     // صح
ثابت م = ن.نسخة(ص: ٠)
