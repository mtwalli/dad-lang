// أنواع القيم، التعدادات، والمطابقة الشاملة
نوع نقطة(س: عشري، ص: عشري) {
  دالة بعد() = جذر(س * س + ص * ص)
}

تعداد شكل {
  دائرة(قطر: عشري)
  مستطيل(عرض: عشري، طول: عشري)
  مثلث(قاعدة: عشري، ارتفاع: عشري)
}

دالة مساحة(ش: شكل): عشري = طابق ش {
  دائرة(ق) => 3.1416 * ق * ق / 4
  مستطيل(ع، ط) => ع * ط
  مثلث(ق، ر) => ق * ر / 2
}

ثابت أشكال = [دائرة(2)، مستطيل(3، 4)، مثلث(قاعدة: 6، ارتفاع: 2)]
لكل ش في أشكال {
  اطبع("المساحة = {مساحة(ش)}")
  إذا ش من نوع دائرة { اطبع("قطرها {ش.قطر}") }
}

ثابت ن = نقطة(س: 3، ص: 4)
اطبع(ن.بعد())              // 5
اطبع(ن == نقطة(3، 4))     // صح
ثابت م = ن.نسخة(ص: 0)
