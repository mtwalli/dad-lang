// برنامج من ثلاثة ملفات: شغّله بـ «ضاد شغل الرئيسي.dad»
استورد منتج، فئة من "./نماذج"
استورد السعر_النهائي من "./أسعار"

ثابت سلة = [
    منتج("خبز"، 2.5، طعام)،
    منتج("رواية"، 12.0، كتب)،
    منتج("مطرقة"، 20.0، أدوات)،
]

لكل م في سلة {
    اطبع("{م.اسم}: {السعر_النهائي(م)}")
}
اطبع("المجموع:"، سلة.حول { السعر_النهائي(هو) }.مجموع().تقريب(2))
