// نموذج يتحقق من حقوله قبل أن يرسل: إنشاء حساب.
// شغّله بـ: ضاد تطوير 10-signup.dad

ثابت البلدان = ["مصر"، "السعودية"، "المغرب"، "الأردن"، "ألمانيا"، "بلد آخر"]

جدول حساب {
    الاسم: نص
    البريد: نص
    البلد: نص
}

خادم دالة بريد_مستعمل(البريد: نص): منطقي = حساب.حيث { هو.البريد == البريد }.طول > 0

خادم دالة أنشئ_حساباً(الاسم: نص، البريد: نص، البلد: نص) = حساب.أنشئ(
    الاسم: الاسم،
    البريد: البريد،
    البلد: البلد
)

مكون الرئيسية() {
    حالة الاسم = ""
    حالة البريد = ""
    حالة كلمة_السر = ""
    حالة التأكيد = ""
    حالة البلد = ""
    حالة موافق = خطأ
    حالة المرحب_به = ""
    عمود(عرض: 460، مسافة: 18) {
        عنوان("أنشئ حسابك")
        إذا المرحب_به != "" {
            تنبيه("أهلاً {المرحب_به}، أُنشئ حسابك."، نمط: "نجاح")
        }
        نموذج {
            حقل(الاسم، تسمية: "الاسم"، مطلوب: صح، أدنى_طول: 2)
            حقل(
                البريد،
                تسمية: "البريد الإلكتروني"،
                صيغة: "بريد"،
                مطلوب: صح،
                تحقق: { إذا بريد_مستعمل(هو) { "لهذا البريد حساب من قبل" } وإلا { عدم } }
            )
            حقل(كلمة_السر، تسمية: "كلمة السر"، صيغة: "كلمة_سر"، مطلوب: صح، أدنى_طول: 8)
            حقل(
                التأكيد،
                تسمية: "أعد كلمة السر"،
                صيغة: "كلمة_سر"،
                مطلوب: صح،
                تحقق: { إذا هو == كلمة_السر { عدم } وإلا { "لا تطابق كلمة السر" } }
            )
            قائمة_منسدلة(البلد، البلدان، تسمية: "البلد"، تلميح: "اختر بلدك"، مطلوب: صح)
            مربع_اختيار(موافق، نص: "أوافق على شروط الاستخدام"، مطلوب: صح)
            زر("أنشئ الحساب"، أيقونة: "مستخدم"، ملء: صح) {
                أنشئ_حساباً(الاسم، البريد، البلد)
                المرحب_به = الاسم
                الاسم = ""
                البريد = ""
                كلمة_السر = ""
                التأكيد = ""
                البلد = ""
                موافق = خطأ
            }
        }
    }
}
