// عناصر الواجهة وتخصيصها: مكتبة كتب صغيرة.
// شغّله بـ: ضاد تطوير 09-library.dad — ويُحمَّل معه تنسيقه الخاص 09-library.css

سمة(اللون: "فيروزي"، الزوايا: 12)

ثابت التصنيفات = ["رواية"، "شعر"، "تاريخ"، "علوم"]
ثابت الحالات = ["أريد قراءته"، "أقرؤه"، "قرأته"]

جدول كتاب {
    العنوان: نص
    المؤلف: نص
    التصنيف = "رواية"
    الحالة = "أريد قراءته"
    التاريخ = ""
    الملاحظات = ""
}

خادم دالة كل_الكتب() = كتاب.الكل()

خادم دالة أضف(
    العنوان: نص،
    المؤلف: نص،
    التصنيف: نص،
    الحالة: نص،
    التاريخ: نص،
    الملاحظات: نص
) = كتاب.أنشئ(
    العنوان: العنوان،
    المؤلف: المؤلف،
    التصنيف: التصنيف،
    الحالة: الحالة،
    التاريخ: التاريخ،
    الملاحظات: الملاحظات
)

خادم دالة احذف_بالرقم(رقم: صحيح) = كتاب.بالرقم(رقم)؟.احذف()

مكون الرئيسية() {
    حالة اللسان = "الكتب"
    حالة الرسالة = ""
    حالة العنوان = ""
    حالة المؤلف = ""
    حالة التصنيف = "رواية"
    حالة القراءة = "أريد قراءته"
    حالة التاريخ = ""
    حالة الملاحظات = ""
    حالة التأكيد = خطأ
    حالة المختار = 0
    ثابت الكتب = كل_الكتب()
    عمود(مسافة: 20) {
        صف(صنف: "رأس") {
            أيقونة("كتاب"، حجم: "كبير"، لون: "أساسي")
            عنوان("مكتبتي")
        }
        إذا الرسالة != "" { تنبيه(الرسالة، نمط: "نجاح") }
        ألسنة(اللسان) {
            لسان("الكتب"، أيقونة: "قائمة") {
                جدول_عرض(
                    الكتب،
                    أعمدة: ["العنوان"، "المؤلف"، "التصنيف"، "الحالة"]،
                    فارغ: "لا كتب بعد. أضف أول كتاب."
                ) { الكتاب =>
                    زر("احذف"، نمط: "خفيف"، حجم: "صغير"، أيقونة: "حذف") {
                        المختار = الكتاب.رقم
                        التأكيد = صح
                    }
                }
            }
            لسان("أضف كتاباً"، أيقونة: "أضف") {
                بطاقة {
                    نموذج(مسافة: 14) {
                        حقل(العنوان، تسمية: "العنوان"، مطلوب: صح)
                        حقل(المؤلف، تسمية: "المؤلف"، مطلوب: صح، أدنى_طول: 2)
                        قائمة_منسدلة(التصنيف، التصنيفات، تسمية: "التصنيف")
                        اختيار(القراءة، الحالات، تسمية: "الحالة")
                        حقل(التاريخ، تسمية: "تاريخ الشراء"، صيغة: "تاريخ")
                        منطقة_نص(الملاحظات، تسمية: "ملاحظات"، أسطر: 3، أقصى_طول: 300)
                        زر("احفظ"، أيقونة: "حفظ"، ملء: صح) {
                            أضف(العنوان.قص()، المؤلف، التصنيف، القراءة، التاريخ، الملاحظات)
                            الرسالة = "أُضيف «{العنوان.قص()}» إلى مكتبتك."
                            العنوان = ""
                            المؤلف = ""
                            الملاحظات = ""
                            اللسان = "الكتب"
                        }
                    }
                }
            }
            لسان("حسب التصنيف"، أيقونة: "رسم_بياني") {
                قائمة_عناصر(التصنيفات) { ت =>
                    صف {
                        فقرة(ت)
                        فقرة("({الكتب.عدد { هو.التصنيف == ت }})"، لون: "باهت")
                    }
                }
            }
        }
        نافذة(التأكيد، عنوان: "حذف الكتاب") {
            فقرة("سيُحذف الكتاب من مكتبتك.")
            صف {
                زر("احذف"، نمط: "خطر") {
                    احذف_بالرقم(المختار)
                    التأكيد = خطأ
                    الرسالة = "حُذف الكتاب."
                }
                زر("إلغاء"، نمط: "ثانوي") { التأكيد = خطأ }
            }
        }
    }
}
