// المتغيرات، الشروط، الحلقات، والدوال المختصرة
دالة مربع(س: صحيح) = س * س

دالة وصف(درجة: صحيح) = إذا درجة >= 90 { "ممتاز" } وإلا إذا درجة >= 50 { "ناجح" } وإلا { "راسب" }

متغير مجموع = 0
لكل ع من 1 إلى 10 {
    مجموع += مربع(ع)
}
اطبع("مجموع المربعات: {مجموع}")

لكل ع من 0 حتى 10 بخطوة 2 { اطبع(ع) }

ثابت درجات = [95، 72، 40]
لكل د في درجات {
    اطبع("{د} => {وصف(د)}")
}

ثابت كبار = درجات.رشح { هو >= 50 }.حول { هو * 2 }
ثابت متوسط = درجات.اختزل(0) { أ، ب => أ + ب } ك عشري / 3.0
