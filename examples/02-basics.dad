// المتغيرات، الشروط، الحلقات، والدوال المختصرة
دالة مربع(س: صحيح) = س * س

دالة وصف(درجة: صحيح) = إذا درجة >= ٩٠ { "ممتاز" } وإلا إذا درجة >= ٥٠ { "ناجح" } وإلا { "راسب" }

متغير مجموع = ٠
لكل ع من ١ إلى ١٠ {
  مجموع += مربع(ع)
}
اطبع("مجموع المربعات: {مجموع}")

لكل ع من ٠ حتى ١٠ بخطوة ٢ { اطبع(ع) }

ثابت درجات = [٩٥، 72، ٤٠]
لكل د في درجات {
  اطبع("{د} => {وصف(د)}")
}

ثابت كبار = درجات.رشح { هو >= ٥٠ }.حول { هو * ٢ }
ثابت متوسط = درجات.اختزل(٠) { أ، ب => أ + ب } ك عشري / ٣٫٠
