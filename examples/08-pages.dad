// برنامج من عدة صفحات: لكل صفحة عنوانها، والروابط بينها تفتحها في مكانها.
// شغّله بـ: ضاد تطوير 08-pages.dad

جدول مهمة {
    العنوان: نص
    الملاحظات = ""
    منجزة = خطأ
}

خادم دالة كل_المهام() = مهمة.الكل()
خادم دالة أضف(العنوان: نص) = مهمة.أنشئ(العنوان: العنوان)
خادم دالة احفظ(م: مهمة) = م.احفظ()
خادم دالة احذف(م: مهمة) = م.احذف()

صفحة "/" = قائمة_المهام()
صفحة "/مهمة/{رقم}" = صفحة_المهمة(رقم)

صفحة "/عن" {
    الشريط()
    عنوان("عن التطبيق")
    فقرة("مثال على برنامج بلغة ضاد فيه ثلاث صفحات، يتنقل بينها الزائر بالروابط وبزر الرجوع.")
}

// الشريط في أعلى كل صفحة. الرابط إلى الصفحة المعروضة يُميَّز وحده.
مكون الشريط() {
    صف {
        رابط("المهام"، "/")
        رابط("عن التطبيق"، "/عن")
    }
    فاصل()
}

مكون قائمة_المهام() {
    حالة الجديدة = ""
    ثابت المهام = كل_المهام()
    الشريط()
    عمود {
        عنوان("المهام ({المهام.عدد { ليس هو.منجزة }} باقية)")
        صف {
            حقل(الجديدة، تلميح: "مهمة جديدة…")
            زر("أضف"، معطل: الجديدة.قص() == "") {
                ثابت م = أضف(الجديدة.قص())
                انتقل("/مهمة/{م.رقم}")
            }
        }
        لكل م في المهام {
            ثابت العلامة = إذا م.منجزة { "✓ " } وإلا { "" }
            رابط(العلامة + م.العنوان، "/مهمة/{م.رقم}")
        }
    }
}

مكون صفحة_المهمة(رقم: صحيح) {
    ثابت م = مهمة.بالرقم(رقم)
    الشريط()
    إذا م == عدم {
        عنوان("لا توجد مهمة رقم {رقم}")
        رابط("إلى المهام"، "/")
    } وإلا {
        تفاصيل(م)
    }
}

مكون تفاصيل(م: مهمة) {
    حالة الملاحظات = م.الملاحظات
    عمود {
        عنوان(م.العنوان)
        مربع_اختيار(م.منجزة، نص: "منجزة") { احفظ(م.نسخة(منجزة: هو)) }
        حقل(الملاحظات، تلميح: "ملاحظات…")
        صف {
            زر("احفظ") {
                احفظ(م.نسخة(الملاحظات: الملاحظات))
                انتقل("/")
            }
            زر("احذف") {
                احذف(م)
                انتقل("/")
            }
        }
    }
}
