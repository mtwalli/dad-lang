// واجهة بلا خادم: مكونات بمعاملات، وحالة لكل نسخة، وحقول
مكون عداد(اسم: نص، بداية: صحيح = 0) {
    حالة ع = بداية
    بطاقة {
        عنوان("{اسم}: {ع}"، مستوى: 2)
        صف {
            زر("زد") { ع += 1 }
            زر("أنقص"، معطل: ع == 0) { ع -= 1 }
            زر("صفّر") { ع = بداية }
        }
    }
}

مكون الرئيسية {
    حالة اسم = ""
    حالة خطوة = 1
    عمود {
        عنوان("عدّادات")
        فقرة("لكل عداد حالته الخاصة.")
        عداد("التفاح")
        عداد("البرتقال"، بداية: 5)
        فاصل()
        صف {
            حقل(اسم، تلميح: "ما اسمك؟")
            حقل(خطوة)
        }
        إذا اسم != "" { فقرة("أهلاً يا {اسم}، الخطوة {خطوة * 2}") }
        مربع_اختيار(خطوة > 1، نص: "الخطوة أكبر من 1")
        رابط("عن ضاد"، "https://mtwalli.github.io/dad-lang/")
    }
}
