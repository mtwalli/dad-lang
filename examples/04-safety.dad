// الأمان من القيم المفقودة، الأخطاء، العقود والامتدادات
نوع مستخدم(اسم: نص، بريد: نص؟ = عدم)

دالة بريد_العرض(م: مستخدم؟): نص {
  ثابت بريد = م؟.بريد
  إذا بريد != عدم {
    أرجع "{بريد} ({بريد.طول} حرفاً)" // تحويل ذكي: بريد هنا نص
  }
  أرجع م؟.بريد ؟؟ "لا يوجد بريد"
}

دالة اقسم(أ: صحيح، ب: صحيح): صحيح {
  إذا ب == 0 { ارفع مشكلة("قسمة على صفر") }
  أرجع أ / ب
}

ثابت ناتج = حاول { اقسم(10، 0) } التقط خ { اطبع(خ.رسالة)؛ 0 }

عقد قابل_للعرض {
  دالة اعرض(): نص
}

امتداد نص {
  خاص دالة نظيف() = هذا.قص()
  دالة مكرر(مرات: صحيح) = (من 1 إلى مرات).حول { هذا }.ضم("")
}

اطبع("هلا ".مكرر(3))
اطبع(بريد_العرض(مستخدم("هدى"، بريد: "huda@example.com")))
اطبع(بريد_العرض(عدم))
